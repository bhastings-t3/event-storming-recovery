  subgraph "cluster_build-example-demo" {
    label="Operator rebuilds the bundled toy-shop example (npm run demo)"; fontsize=13; color="#4a4a56"; style="rounded"; fontcolor="#e4e4e7";
    "build-example-demo__actor-operator" [label="Operator", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded", tooltip="The developer/orchestrator who runs the recovery CLIs (es-merge, es-generate, demo) and launches es-view. Here they boot the interactive explorer with `npx event-storming-recovery`, `es-view`, or `npm run preview`."];
    "build-example-demo__cmd-build-example" [label="BuildExample", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Regenerate the bundled toy-shop example model and its views in one shot. A thin convenience wrapper (npm run demo) that synchronously chains the merge CLI and then the generate-views CLI over the shipped example, so the shipped default explorer stays in sync with its trace set.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/package.json:31"];
    "build-example-demo__cmd-merge-traces" [label="MergeTraces", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Fold every per-flow trace document into one canonical, validated model. Nodes are unioned by global id, flows/hotspots/terms accumulated, derived meta computed, and all invariants checked before the model is returned.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/lib/merge.mjs:238"];
    "build-example-demo__agg-model" [label="The Model", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The canonical Event Storming model (flows.json): the deduped node set plus flows, hotspots, terms, and derived meta. Built by the merge, then read by the es-view server and generator. In this flow it is read-only -- the source of truth the selection is validated against and grounded from.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/resolve-model.mjs:65"];
    "build-example-demo__cmd-generate-views" [label="GenerateViews", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Render the canonical flows.json into the two shipped views: a Graphviz flows.dot digraph (one cluster per flow, event-storming palette) and a self-contained interactive explorer.html with the whole model inlined. Invoked as the second synchronous step of the demo wrapper.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/tools/generate-views.js:19"];
    "build-example-demo__rm-flows-dot" [label="Graphviz flows.dot", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The Graphviz digraph (flows.dot): one cluster per flow with event-storming-colored stickies and labeled edges, rendered offline (e.g. `dot -Tsvg`) or in a Graphviz viewer to read the whole board at a glance. Physical storage nodes and any edge touching them are deliberately excluded.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/tools/generate-views.js:64"];
    "build-example-demo__rm-explorer" [label="Interactive explorer.html", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The self-contained interactive Event Storming explorer: a single HTML file with the entire model serialized inline and vanilla-JS/CSS UI (Flows board, Gallery, Data model, Glossary, Overview tabs, detail panel with source anchors). The primary human-facing read model, openable directly in a browser ", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/tools/generate-views.js:96"];
    "build-example-demo__ext-source-fs" [label="Local filesystem", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="The local filesystem outside the process boundary. Holds the per-flow trace JSONs read as input and receives the merged flows.json written as output (CLI path only; the server keeps the merged model in memory). In this flow it is the source of the REAL code excerpts each grounded projection pulls be", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/source.mjs:13"];
    "build-example-demo__actor-operator" -> "build-example-demo__cmd-build-example" [label="issues"];
    "build-example-demo__cmd-build-example" -> "build-example-demo__cmd-merge-traces" [label="invokes"];
    "build-example-demo__cmd-merge-traces" -> "build-example-demo__agg-model" [label="handled by"];
    "build-example-demo__agg-model" -> "build-example-demo__ext-source-fs" [label="persists to"];
    "build-example-demo__cmd-build-example" -> "build-example-demo__cmd-generate-views" [label="invokes"];
    "build-example-demo__cmd-generate-views" -> "build-example-demo__agg-model" [label="reads"];
    "build-example-demo__cmd-generate-views" -> "build-example-demo__rm-flows-dot" [label="writes"];
    "build-example-demo__cmd-generate-views" -> "build-example-demo__rm-explorer" [label="writes"];
    "build-example-demo__rm-flows-dot" -> "build-example-demo__ext-source-fs" [label="persists to"];
    "build-example-demo__rm-explorer" -> "build-example-demo__ext-source-fs" [label="persists to"];
  }
  subgraph "cluster_claude-mcp-read" {
    label="A connected Claude session reads the live model/selection/bundle over MCP"; fontsize=13; color="#4a4a56"; style="rounded"; fontcolor="#e4e4e7";
    "claude-mcp-read__actor-claude" [label="Connected Claude session", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded", tooltip="A Claude session connected to the es-view MCP endpoint (same process as the SPA). It reads the curated bundle by @-mentioning the event-storming://selected-nodes resource, receiving the whole gathered set as grounded markdown so a refactor request is anchored to real files, not just labels."];
    "claude-mcp-read__ext-claude-mcp-client" [label="Claude MCP client (streamable-HTTP transport)", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="The Claude process across the process boundary that speaks MCP to POST /mcp over streamable HTTP. It is the external system the read requests arrive from; the @modelcontextprotocol/sdk used server-side is an in-process LIBRARY, not this external system.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/mcp.mjs:120"];
    "claude-mcp-read__rm-current-selection" [label="Current selection (grounded)", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The grounded projection of the selected node that a connected Claude session (or the SPA detail panel) reads: the node's label, type, description, the invariants it enforces, the flows it appears in, and the REAL source behind each anchor. Pull-based and always fresh -- computed on each request from", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/mcp.mjs:30"];
    "claude-mcp-read__rm-node-context" [label="Grounded node context", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The full grounded context for any node id: its type, description, fields, physical breadcrumb/columns, what uses it, storage links, the invariant relation, the flows it appears in, and source anchors with real code. Returned by get_node and used by the SPA detail panel and GET /api/item.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/mcp.mjs:44"];
    "claude-mcp-read__rm-flow-context" [label="Grounded flow (with Mermaid graph)", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="A whole flow grounded in code: its trigger/summary, the edges as labeled verbs, its hotspots (open questions), every node grounded with source anchors, and a Mermaid flowchart colored by the event-storming palette so the model sees the graph structurally. Returned by get_flow.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/mcp.mjs:57"];
    "claude-mcp-read__rm-model-index" [label="Raw model payload", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The whole resolved model plus provenance meta, returned as one JSON payload from GET /api/model (the same projection the MCP list_model tool exposes). The SPA holds it in a single React context and re-derives every tab from it -- it is the substrate, not a rendered view.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/server.mjs:114"];
    "claude-mcp-read__rm-data-model" [label="Data-model tab", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The physical storage the code actually touches, as a tree: server ▸ database ▸ table ▸ column, and for each table the behavioral nodes that write/read/project it. Answers 'what tables does this touch / where does this data live / who writes this table'. Returned by list_data_model and shown in the D", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/web/components/DataModel.jsx:3"];
    "claude-mcp-read__rm-context-bundle" [label="Curated context bundle", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The curated bundle projected to one grounded markdown document: each gathered node/flow/hotspot rendered with its description, invariants, flows, source anchors (real code), and for flows a colored Mermaid graph, joined by rules. This is what actor-claude reads. Exposed two ways: the MCP resource ev", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/context.mjs:158"];
    "claude-mcp-read__agg-selection" [label="Selection / Context bundle", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The live 'what am I looking at / what have I gathered' state for one es-view run, held purely in memory and shared same-process between the SPA API and the MCP bridge. This flow uses its bundle facet: an insertion-ordered set of typed refs { type: node|flow|hotspot, id }; the selection tracer uses t", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/state.mjs:11"];
    "claude-mcp-read__agg-model" [label="The Model", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The canonical Event Storming model (flows.json): the deduped node set plus flows, hotspots, terms, and derived meta. Built by the merge, then read by the es-view server and generator. In this flow it is read-only -- the source of truth the selection is validated against and grounded from.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/resolve-model.mjs:65"];
    "claude-mcp-read__ext-source-fs" [label="Local filesystem", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="The local filesystem outside the process boundary. Holds the per-flow trace JSONs read as input and receives the merged flows.json written as output (CLI path only; the server keeps the merged model in memory). In this flow it is the source of the REAL code excerpts each grounded projection pulls be", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/source.mjs:13"];
