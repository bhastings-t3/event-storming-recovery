{
  "name": "event-storming-recovery",
  "version": "0.5.0",
  "description": "Recover a strategic Event Storming model from an existing codebase and render it as a navigable, source-linked flow explorer.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "event-storming-recovery": "dist/node/adapters/cli/es-view.js",
    "es-view": "dist/node/adapters/cli/es-view.js",
    "es-merge": "dist/node/adapters/cli/es-merge.js",
    "es-generate": "dist/node/adapters/cli/es-generate.js"
  },
  "files": [
    "dist",
    "scripts",
    "prompts",
    "docs",
    "skills",
    "examples",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:node": "tsc -p tsconfig.node.json",
    "build:web": "vite build",
    "build": "npm run build:node && npm run build:web",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "preview": "npm run build && node dist/node/adapters/cli/es-view.js",
    "demo": "node scripts/build-example.mjs",
    "pretest": "npm run build:node",
    "test": "node --test",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.7"
  },
  "keywords": [
    "event-storming",
    "ddd",
    "domain-driven-design",
    "reverse-engineering",
    "architecture",
    "code-comprehension"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
