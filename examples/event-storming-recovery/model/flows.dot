  subgraph "cluster_es-view-boot" {
    label="Operator boots the es-view explorer server"; fontsize=13; color="#4a4a56"; style="rounded"; fontcolor="#e4e4e7";
    "es-view-boot__actor-operator" [label="Operator", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded", tooltip="The developer/orchestrator who runs the recovery CLIs (es-merge, es-generate, demo) and launches es-view. Here they boot the interactive explorer with `npx event-storming-recovery`, `es-view`, or `npm run preview`."];
    "es-view-boot__cmd-launch-es-view" [label="LaunchExplorer", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Stand up the interactive Event Storming explorer: resolve a servable model, create the shared in-memory session state, bind a local port, print the connect banner, and open the browser. One synchronous process init that leaves a live server behind.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/bin/es-view.mjs:75"];
    "es-view-boot__agg-es-view-session" [label="es-view Server Session", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The single live node:http process the boot leaves running: it binds one loopback port and serves the React SPA, the JSON API, and the MCP endpoint over one shared in-memory state. Its lifecycle is this flow -- created at boot, resolves and holds the read-only model + indexes (services), initializes ", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/server.mjs:194"];
    "es-view-boot__agg-model" [label="The Model", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The canonical Event Storming model (flows.json): the deduped node set plus flows, hotspots, terms, and derived meta. Built by the merge, then read by the es-view server and generator. In this flow it is read-only -- the source of truth the selection is validated against and grounded from.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/resolve-model.mjs:65"];
    "es-view-boot__evt-model-resolved" [label="ModelResolved", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded", tooltip="A servable model has been located and loaded into memory -- from an explicit --model, an on-the-fly --traces merge, an auto-discovered flows.json, or the bundled toy-shop example -- with its provenance and repo-root fixed, so the session has a concrete model to serve and anchor.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/resolve-model.mjs:104"];
    "es-view-boot__agg-selection" [label="Selection / Context bundle", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The live 'what am I looking at / what have I gathered' state for one es-view run, held purely in memory and shared same-process between the SPA API and the MCP bridge. This flow uses its bundle facet: an insertion-ordered set of typed refs { type: node|flow|hotspot, id }; the selection tracer uses t", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/state.mjs:11"];
    "es-view-boot__evt-server-started" [label="ServerStarted", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded", tooltip="The one local server is bound and listening: the SPA, JSON API, and MCP endpoint are live on a concrete URL, and the base URL is recorded so the app can print the exact `claude mcp add` connect command. From here the operator can open the browser and a Claude session can attach.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/server.mjs:202"];
    "es-view-boot__ext-browser" [label="Default web browser", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="The operator's default web browser, outside the process boundary. At the end of boot es-view opens the served URL in it (unless --no-open) so the operator lands directly on the explorer SPA.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/open.mjs:4"];
    "es-view-boot__ext-source-fs" [label="Local filesystem", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="The local filesystem outside the process boundary. Holds the per-flow trace JSONs read as input and receives the merged flows.json written as output (CLI path only; the server keeps the merged model in memory). In this flow it is the source of the REAL code excerpts each grounded projection pulls be", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/source.mjs:13"];
    "es-view-boot__inv-servable-model" [label="The session only comes up on a well-formed, validated model", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="The boot must refuse to start serving an unservable model. An explicit/discovered flows.json that is not a valid flows document (missing nodes/flows arrays) is rejected; a --traces merge that produced validation errors throws; and any resolve failure aborts the launch with a nonzero exit instead of ", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/resolve-model.mjs:50"];
