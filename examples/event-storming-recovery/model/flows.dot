    "merge-traces__actor-operator" [label="Operator", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded", tooltip="The developer/orchestrator who runs the recovery CLIs (es-merge, es-generate, demo) and launches es-view. Here they boot the interactive explorer with `npx event-storming-recovery`, `es-view`, or `npm run preview`."];
    "merge-traces__rm-trace" [label="Per-flow trace JSON", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="A single per-flow trace document authored by a deep-trace agent: { nodes, flows, hotspots, terms } for one flow. The merge reads every such file in the traces directory as the raw material for the model.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/lib/merge.mjs:244"];
    "merge-traces__cmd-merge-traces" [label="MergeTraces", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Fold every per-flow trace document into one canonical, validated model. Nodes are unioned by global id, flows/hotspots/terms accumulated, derived meta computed, and all invariants checked before the model is returned.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/lib/merge.mjs:238"];
    "merge-traces__agg-model" [label="The Model", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The canonical Event Storming model (flows.json): the deduped node set plus flows, hotspots, terms, and derived meta. Built by the merge, then read by the es-view server and generator. In this flow it is read-only -- the source of truth the selection is validated against and grounded from.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/resolve-model.mjs:65"];
    "merge-traces__evt-model-merged" [label="ModelMerged", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded", tooltip="The per-flow traces have been folded into one deduped model: shared nodes unioned by global id, flows/hotspots/terms accumulated, and derived meta (counts, shared-concept glossary, dead-flow index) computed.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/lib/merge.mjs:80"];
    "merge-traces__evt-model-validated" [label="ModelValidated", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded", tooltip="The merged model has been checked against every invariant and passed with zero errors, so it is safe to serve or persist. When errors exist the fact does not hold; the CLI reports them and exits nonzero, and the server refuses to serve.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/lib/merge.mjs:150"];
    "merge-traces__ext-source-fs" [label="Local filesystem", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="The local filesystem outside the process boundary. Holds the per-flow trace JSONs read as input and receives the merged flows.json written as output (CLI path only; the server keeps the merged model in memory). In this flow it is the source of the REAL code excerpts each grounded projection pulls be", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/source.mjs:13"];
    "merge-traces__inv-referential-integrity" [label="Every id reference resolves and ids are unique", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="The model must be a closed graph: nodes are well-formed with known types and unique ids, and every reference (flow steps, edge from/to, flow hotspots, term relatedNodes) points at a defined node. Dangling references or id collisions are ERRORS that fail the merge.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/lib/merge.mjs:151"];
    "merge-traces__inv-es-grammar" [label="Aggregates never issue commands", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="The Event Storming grammar rule enforced at merge time: an aggregate may only receive commands and emit events, never issue one. An edge from an aggregate node with verb 'issues' is an ERROR.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/lib/merge.mjs:166"];
    "merge-traces__inv-terms-contract" [label="Terms are resolved-with-definition or flagged-with-a-question", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="Every ubiquitous-language term must be well-formed and honor the flag-or-resolve contract: a resolved term carries a definition; a partial/unresolved term carries the specific openQuestion a human should answer; and any relatedNodes must resolve. Violations are ERRORS.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/lib/merge.mjs:175"];
    "merge-traces__inv-data-lineage" [label="Physical containment and field lineage are well-formed", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="The data-model layer must be internally consistent: a physical node's parent must resolve and form an acyclic containment chain, and each field must have a name+derivation with any local-looking source ref resolving to a known node. Violations are ERRORS.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/lib/merge.mjs:132"];
    "merge-traces__actor-operator" -> "merge-traces__cmd-merge-traces" [label="issues"];
    "merge-traces__rm-trace" -> "merge-traces__ext-source-fs" [label="projects from"];
    "merge-traces__cmd-merge-traces" -> "merge-traces__rm-trace" [label="reads"];
    "merge-traces__cmd-merge-traces" -> "merge-traces__agg-model" [label="handled by"];
    "merge-traces__agg-model" -> "merge-traces__inv-referential-integrity" [label="enforces"];
    "merge-traces__agg-model" -> "merge-traces__inv-es-grammar" [label="enforces"];
    "merge-traces__agg-model" -> "merge-traces__inv-terms-contract" [label="enforces"];
    "merge-traces__agg-model" -> "merge-traces__inv-data-lineage" [label="enforces"];
    "merge-traces__agg-model" -> "merge-traces__evt-model-merged" [label="emits"];
    "merge-traces__agg-model" -> "merge-traces__evt-model-validated" [label="emits"];
    "merge-traces__agg-model" -> "merge-traces__ext-source-fs" [label="persists to"];
  }
  subgraph "cluster_register-mcp" {
    label="Viewer connects their Claude terminal from the explorer"; fontsize=13; color="#4a4a56"; style="rounded"; fontcolor="#e4e4e7";
    "register-mcp__actor-viewer" [label="Viewer", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded", tooltip="The human viewing the Event Storming explorer SPA. Here they curate a bundle: right-clicking or clicking 'Add to context' on nodes, whole flows, and hotspots to gather the set they want to hand to Claude, then optionally copying it or leaving it for a connected Claude session to @-mention."];
    "register-mcp__rm-mcp-connect-command" [label="MCP connect command", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The exact `claude mcp add` command the viewer would run to connect this session, shown WITHOUT running it. It lets the human read/copy the command instead of (or before) letting the app run it. Surfaced three ways: the SPA renders it under the button, GET /api/mcp/info returns it, and the es-view CL", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/server.mjs:174"];
    "register-mcp__cmd-register-mcp" [label="RegisterMcp", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Register this running es-view app as an MCP server in the user's Claude configuration at the chosen scope, by having the server run `claude mcp add` on the host on the viewer's behalf. This is the single most surprising write in the app: a browser click spawns a host-side process running the user's ", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/web/components/ConnectClaude.jsx:20"];
    "register-mcp__agg-mcp-registration" [label="MCP Registration", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="This app's registration as an MCP server (alias 'event-storming') inside the user's Claude configuration. It has no state inside the es-view process: its state lives entirely in the external Claude CLI's config (a project-local list, a shared .mcp.json, or the user-global settings, per --scope). The", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/mcp-register.mjs:13"];
    "register-mcp__evt-mcp-registered" [label="McpRegistered", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded", tooltip="The app is now registered as an MCP server named 'event-storming' in the user's chosen Claude scope. The viewer is told to run /mcp in Claude (restarting it if already open), then click a node and ask 'explain the selected node'.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/mcp-register.mjs:21"];
    "register-mcp__ext-claude-cli" [label="Claude CLI", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="The user's Claude Code command-line tool, outside the es-view process boundary. `claude mcp add` mutates the user's own MCP configuration (a project-local entry, a shared .mcp.json, or the user-global settings depending on --scope). The es-view server shells out to it as the same OS user, so the eff", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/mcp-register.mjs:15"];
    "register-mcp__inv-mcp-input-safe" [label="Registration inputs are fixed and non-injectable (scope whitelisted)", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="The only variable in the shelled command is the scope, which must be one of {local, project, user}; anything else is dropped. The subcommands are fixed, and the URL is the app's own localhost address (quoted). So even though the command runs through a shell, nothing user-supplied can be injected int", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/mcp-register.mjs:11"];
    "register-mcp__rm-mcp-connect-command" -> "register-mcp__actor-viewer" [label="read by"];
    "register-mcp__actor-viewer" -> "register-mcp__cmd-register-mcp" [label="issues"];
    "register-mcp__cmd-register-mcp" -> "register-mcp__agg-mcp-registration" [label="handled by"];
    "register-mcp__cmd-register-mcp" -> "register-mcp__ext-claude-cli" [label="calls"];
    "register-mcp__agg-mcp-registration" -> "register-mcp__inv-mcp-input-safe" [label="enforces"];
    "register-mcp__agg-mcp-registration" -> "register-mcp__evt-mcp-registered" [label="emits"];
  }
  subgraph "cluster_view-source" {
    label="Viewer grounds a sticky in the real code behind its anchor"; fontsize=13; color="#4a4a56"; style="rounded"; fontcolor="#e4e4e7";
    "view-source__actor-viewer" [label="Viewer", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded", tooltip="The human viewing the Event Storming explorer SPA. Here they curate a bundle: right-clicking or clicking 'Add to context' on nodes, whole flows, and hotspots to gather the set they want to hand to Claude, then optionally copying it or leaving it for a connected Claude session to @-mention."];
    "view-source__cmd-view-source" [label="ViewSource", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Fetch the REAL code behind an anchor so the viewer can ground a command/aggregate/event/etc. sticky in the actual implementation. Given an anchor's { path, line }, return a small windowed excerpt (line +/- 8) read from the target repo, sandboxed to the repo root.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/web/components/Detail.jsx:103"];
    "view-source__ext-source-fs" [label="Local filesystem", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="The local filesystem outside the process boundary. Holds the per-flow trace JSONs read as input and receives the merged flows.json written as output (CLI path only; the server keeps the merged model in memory). In this flow it is the source of the REAL code excerpts each grounded projection pulls be", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/source.mjs:13"];
    "view-source__rm-source-excerpt" [label="Source excerpt", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The windowed code the viewer reads to ground a sticky: { path, exists, line, startLine, endLine, code } where code is the anchored line +/- 8 lines. Returned by GET /api/source and rendered inline under the anchor (or, on failure, a 'source not found' note).", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/source.mjs:24"];
    "view-source__ext-editor" [label="Local editor (VS Code)", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="The OS/editor outside the process boundary that handles vscode://file/... deep links. The sibling grounding path: instead of the inline excerpt, the viewer clicks the anchor's <a> href, and the OS hands the vscode:// URL to the editor, which opens the real file at the given line straight from the fi", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/web/model.js:43"];
