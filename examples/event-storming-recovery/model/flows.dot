digraph event_storming {
  bgcolor="#0a0a0d"; rankdir=LR; fontname="Segoe UI"; compound=true;
  node [shape=box, style="filled,rounded", fontname="Segoe UI", fontsize=10, margin="0.15,0.08"];
  edge [fontname="Segoe UI", fontsize=8, color="#8a8a94", fontcolor="#a1a1aa"];
  subgraph "cluster_browser-load-model" {
    label="Viewer opens the explorer and the SPA loads the whole model once"; fontsize=13; color="#4a4a56"; style="rounded"; fontcolor="#e4e4e7";
    "browser-load-model__actor-viewer" [label="Viewer", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded", tooltip="The human viewing the Event Storming explorer SPA. Here they curate a bundle: right-clicking or clicking 'Add to context' on nodes, whole flows, and hotspots to gather the set they want to hand to Claude, then optionally copying it or leaving it for a connected Claude session to @-mention."];
    "browser-load-model__cmd-load-model" [label="LoadModel", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="The SPA's boot read: fetch the whole canonical model once so every tab can be derived from it client-side. A read command (no aggregate write) issued implicitly when the explorer page mounts.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/web/App.jsx:44"];
    "browser-load-model__agg-model" [label="The Model", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The canonical Event Storming model (flows.json): the deduped node set plus flows, hotspots, terms, and derived meta. Built by the merge, then read by the es-view server and generator. In this flow it is read-only -- the source of truth the selection is validated against and grounded from.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/resolve-model.mjs:65"];
    "browser-load-model__rm-model-index" [label="Raw model payload", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The whole resolved model plus provenance meta, returned as one JSON payload from GET /api/model (the same projection the MCP list_model tool exposes). The SPA holds it in a single React context and re-derives every tab from it -- it is the substrate, not a rendered view.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/server.mjs:114"];
    "browser-load-model__rm-flow-board" [label="Flows board", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The default tab: the left sidebar (flows grouped by tier / pivoted by actor or aggregate) plus the pan/zoom board rendering the currently selected flow's sticky lane. What the viewer reads to navigate the recovered flows.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/web/components/Sidebar.jsx:3"];
    "browser-load-model__rm-data-model" [label="Data-model tab", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The physical storage the code actually touches, as a tree: server ▸ database ▸ table ▸ column, and for each table the behavioral nodes that write/read/project it. Answers 'what tables does this touch / where does this data live / who writes this table'. Returned by list_data_model and shown in the D", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/web/components/DataModel.jsx:3"];
    "browser-load-model__rm-glossary" [label="Glossary tab", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The ubiquitous language as an alphabetical dictionary: every sticky filtered by type chips and text, optionally restricted to shared (multi-flow) concepts, with letter-header navigation. What the viewer reads to learn the domain vocabulary.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/web/components/Glossary.jsx:10"];
    "browser-load-model__rm-gallery" [label="Gallery tab", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="Every sticky in the model as a filterable grid: type chips plus text search, sorted by palette type order then label. What the viewer reads to browse the full node set regardless of flow.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/web/components/Gallery.jsx:7"];
