digraph event_storming {
  bgcolor="#0a0a0d"; rankdir=LR; fontname="Segoe UI"; compound=true;
  node [shape=box, style="filled,rounded", fontname="Segoe UI", fontsize=10, margin="0.15,0.08"];
  edge [fontname="Segoe UI", fontsize=8, color="#8a8a94", fontcolor="#a1a1aa"];
  subgraph "cluster_add-comment" {
    label="Operator adds a persistent comment to a model item"; fontsize=13; color="#4a4a56"; style="rounded"; fontcolor="#e4e4e7";
    "add-comment__actor-operator" [label="Operator", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded", tooltip="The local developer who runs the recovery CLIs. Here they launch the interactive explorer with `npx event-storming-recovery view` (the `es-view` bin), optionally passing --model / --traces / --port / --no-open, to boot one local server that serves the SPA + JSON API + MCP over a shared in-memory ses"];
    "add-comment__cmd-add-comment" [label="AddComment", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Attach a human comment/note to a specific model item (node, flow, or hotspot), keyed by the item's stable type:id so it survives model regeneration. The note is recorded in the server's in-memory comment store and written through to a comments.json sidecar next to the model.", URL="vscode://file//event-storming-recovery/src/web/components/ContextMenu.jsx:50"];
    "add-comment__agg-comment-store" [label="Comment Store", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The human-comments boundary: an in-memory Map of 'type:id' -> [{ id, text, at }] created per server run, mirrored to a comments.json sidecar next to the model. It deliberately lives OUTSIDE flows.json (which the recovery/merge pipeline regenerates and would wipe) and keys every note by the item's st", URL="vscode://file//event-storming-recovery/src/domain/comment-store/comment-store.ts:29"];
    "add-comment__evt-comment-added" [label="CommentAdded", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded", tooltip="A human note has been attached to a model item: a { id, text, at } record now hangs under the item's stable type:id key in the comment store. This fact holds as soon as the in-memory Map is updated, independently of whether the write-through to comments.json on disk succeeds.", URL="vscode://file//event-storming-recovery/src/domain/comment-store/comment-store.ts:69"];
    "add-comment__rm-item-comments" [label="Item comments (dialog + grounded context)", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The list of human notes for an item, read back in two places: the SPA CommentDialog (each note's text and yyyy-mm-dd date, with a delete ✕) and the grounded markdown a connected Claude session receives via MCP — every node/flow/hotspot context block appends a 'Comments (human notes)' section. This i", URL="vscode://file//event-storming-recovery/src/web/store.jsx:80"];
    "add-comment__inv-comment-target-exists" [label="A comment must target an existing model item", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="ERROR-level guard: AddComment is rejected unless its { type, id } resolves to a real model item — a flow id, a hotspot id, or a node id. A missing id or an unknown item returns HTTP 404 and no comment is recorded. This keeps the sidecar's type:id keys pointing at items the model actually contains.", URL="vscode://file//event-storming-recovery/src/application/commands/add-comment.ts:18"];
    "add-comment__inv-comment-text-nonempty" [label="A comment's text must be non-empty", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="ERROR-level guard: AddComment with blank/whitespace-only text is rejected with HTTP 400 'empty comment' and nothing is stored. The SPA also disables the submit button and returns early on empty text, and the store trims again at record time, but the server 400 is the authoritative rejection.", URL="vscode://file//event-storming-recovery/src/application/commands/add-comment.ts:20"];
    "add-comment__ext-claude-mcp" [label="Connected Claude (MCP client)", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="A connected Claude session acting as an MCP client over the /mcp boundary in the same process. It is the downstream consumer this whole flow exists to serve: after the operator clicks, Claude pulls the selection via the get_current_selection MCP tool to answer about 'the node the user is looking at'", URL="vscode://file//event-storming-recovery/src/adapters/mcp/mcp-server.ts:117"];
    "add-comment__actor-operator" -> "add-comment__cmd-add-comment" [label="issues"];
    "add-comment__cmd-add-comment" -> "add-comment__agg-comment-store" [label="handled by"];
    "add-comment__agg-comment-store" -> "add-comment__inv-comment-target-exists" [label="enforces"];
    "add-comment__agg-comment-store" -> "add-comment__inv-comment-text-nonempty" [label="enforces"];
    "add-comment__agg-comment-store" -> "add-comment__evt-comment-added" [label="emits"];
    "add-comment__evt-comment-added" -> "add-comment__rm-item-comments" [label="triggers"];
    "add-comment__rm-item-comments" -> "add-comment__actor-operator" [label="read by"];
    "add-comment__rm-item-comments" -> "add-comment__ext-claude-mcp" [label="read by"];
  }
  subgraph "cluster_build-context-bundle" {
    label="Operator builds a context bundle for Claude"; fontsize=13; color="#4a4a56"; style="rounded"; fontcolor="#e4e4e7";
    "build-context-bundle__actor-operator" [label="Operator", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded", tooltip="The local developer who runs the recovery CLIs. Here they launch the interactive explorer with `npx event-storming-recovery view` (the `es-view` bin), optionally passing --model / --traces / --port / --no-open, to boot one local server that serves the SPA + JSON API + MCP over a shared in-memory ses"];
    "build-context-bundle__cmd-add-context-item" [label="AddContextItem", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Add one typed reference { type: node | flow | hotspot, id } to the curated context bundle. Idempotent: re-adding an already-present item is a silent no-op that preserves insertion order.", URL="vscode://file//event-storming-recovery/src/web/components/ContextMenu.jsx:46"];
    "build-context-bundle__agg-context-bundle" [label="Context Bundle", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The insertion-ordered set of typed refs { type: 'node' | 'flow' | 'hotspot', id } the human has gathered in the explorer (right-click, 'Add to context bundle'). Purely in-memory session state; the read half consumed by the selected-nodes MCP resource. Shares one createState() closure with the curren", URL="vscode://file//event-storming-recovery/src/domain/session/context-bundle.ts:18"];
    "build-context-bundle__evt-context-item-added" [label="ContextItemAdded", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded", tooltip="A node, flow, or hotspot has been gathered into the context bundle. The fact holds only for a genuinely new ref; re-adding an existing item is absorbed silently and raises nothing.", URL="vscode://file//event-storming-recovery/src/domain/session/context-bundle.ts:28"];
    "build-context-bundle__rm-context-bundle" [label="Context bundle drawer & pill", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="What the operator reads to review the gathered set: the slide-over drawer listing each item as a colored row (label, type, ✕) plus the count on the Context pill. Backed by the bundleItems array the store keeps in sync from every add/remove/clear response. GET /api/context also returns a rendered mar", URL="vscode://file//event-storming-recovery/src/web/components/ContextBundle.jsx:43"];
    "build-context-bundle__cmd-remove-context-item" [label="RemoveContextItem", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Remove one typed reference from the context bundle. Idempotent and unguarded: removing an item that is not present succeeds as a no-op, and unlike add it does NOT check that the id exists in the model.", URL="vscode://file//event-storming-recovery/src/web/components/ContextMenu.jsx:46"];
    "build-context-bundle__cmd-clear-context-bundle" [label="ClearContextBundle", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Empty the entire context bundle in one action. Distinguished from RemoveContextItem by the absence of an id in the DELETE body.", URL="vscode://file//event-storming-recovery/src/web/components/ContextBundle.jsx:59"];
    "build-context-bundle__inv-bundle-item-exists" [label="A bundle item must reference a real model node/flow/hotspot of its type", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="ERROR-level guard on AddContextItem: the POST /api/context route rejects (404) any add whose { type, id } does not resolve to an existing node, flow, or hotspot of that type, so the bundle can never hold a dangling ref. NOTE the guard is asymmetric: it runs only on add (POST); RemoveContextItem (DEL", URL="vscode://file//event-storming-recovery/src/application/commands/add-context-item.ts:12"];
    "build-context-bundle__evt-context-item-removed" [label="ContextItemRemoved", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded", tooltip="A single item has been dropped from the context bundle (via the right-click toggle or the drawer ✕). Idempotent: a remove of an absent item still returns the (unchanged) bundle.", URL="vscode://file//event-storming-recovery/src/domain/session/context-bundle.ts:32"];
    "build-context-bundle__evt-context-bundle-cleared" [label="ContextBundleCleared", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded", tooltip="The entire context bundle has been emptied in one action, resetting it to the boot state.", URL="vscode://file//event-storming-recovery/src/domain/session/context-bundle.ts:37"];
    "build-context-bundle__ext-claude-mcp" [label="Connected Claude (MCP client)", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="A connected Claude session acting as an MCP client over the /mcp boundary in the same process. It is the downstream consumer this whole flow exists to serve: after the operator clicks, Claude pulls the selection via the get_current_selection MCP tool to answer about 'the node the user is looking at'", URL="vscode://file//event-storming-recovery/src/adapters/mcp/mcp-server.ts:117"];
    "build-context-bundle__actor-operator" -> "build-context-bundle__cmd-add-context-item" [label="issues"];
    "build-context-bundle__actor-operator" -> "build-context-bundle__cmd-remove-context-item" [label="issues"];
    "build-context-bundle__actor-operator" -> "build-context-bundle__cmd-clear-context-bundle" [label="issues"];
    "build-context-bundle__cmd-add-context-item" -> "build-context-bundle__agg-context-bundle" [label="handled by"];
    "build-context-bundle__cmd-remove-context-item" -> "build-context-bundle__agg-context-bundle" [label="handled by"];
    "build-context-bundle__cmd-clear-context-bundle" -> "build-context-bundle__agg-context-bundle" [label="handled by"];
    "build-context-bundle__agg-context-bundle" -> "build-context-bundle__inv-bundle-item-exists" [label="enforces"];
    "build-context-bundle__agg-context-bundle" -> "build-context-bundle__evt-context-item-added" [label="emits"];
    "build-context-bundle__agg-context-bundle" -> "build-context-bundle__evt-context-item-removed" [label="emits"];
    "build-context-bundle__agg-context-bundle" -> "build-context-bundle__evt-context-bundle-cleared" [label="emits"];
    "build-context-bundle__evt-context-item-added" -> "build-context-bundle__rm-context-bundle" [label="updates"];
    "build-context-bundle__evt-context-item-removed" -> "build-context-bundle__rm-context-bundle" [label="updates"];
    "build-context-bundle__evt-context-bundle-cleared" -> "build-context-bundle__rm-context-bundle" [label="updates"];
    "build-context-bundle__rm-context-bundle" -> "build-context-bundle__actor-operator" [label="read by"];
    "build-context-bundle__rm-context-bundle" -> "build-context-bundle__ext-claude-mcp" [label="read by"];
  }
  subgraph "cluster_build-example" {
    label="Operator rebuilds the bundled self-model example (npm run demo)"; fontsize=13; color="#4a4a56"; style="rounded"; fontcolor="#e4e4e7";
    "build-example__actor-operator" [label="Operator", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded", tooltip="The local developer who runs the recovery CLIs. Here they launch the interactive explorer with `npx event-storming-recovery view` (the `es-view` bin), optionally passing --model / --traces / --port / --no-open, to boot one local server that serves the SPA + JSON API + MCP over a shared in-memory ses"];
    "build-example__cmd-build-example" [label="BuildExample", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Rebuild the bundled self-model example end to end: an operator-run (or CI-run) automation that sequentially invokes es-merge and then es-generate over the committed example's traces, regenerating examples/event-storming-recovery/model/{flows.json,flows.dot,explorer.html}. Pure composition -- it owns", URL="vscode://file//event-storming-recovery/scripts/build-example.mjs:11"];
    "build-example__cmd-merge-traces" [label="MergeTraces", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Fold every per-flow trace document into one canonical, validated model. Invoked in-process by ResolveModel's --traces tier (merge-on-the-fly) instead of via the es-merge CLI; resolveModel throws if the merge reports any validation error, so the session never serves an invalid merged model.", URL="vscode://file//event-storming-recovery/src/application/commands/merge-traces.ts:16"];
    "build-example__cmd-generate-views" [label="GenerateViews", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Render the canonical flows.json into the two shipped views: a Graphviz flows.dot digraph (one cluster per flow, event-storming palette) and a single self-contained explorer.html with the whole model inlined. A deterministic, stateless projection: it reads the model and writes two files, mutating not", URL="vscode://file//event-storming-recovery/src/adapters/cli/es-generate.ts:25"];
    "build-example__rm-explorer-html" [label="Interactive explorer.html", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The self-contained, no-server interactive explorer the operator opens in a browser: the whole model is inlined as a JS constant and rendered into five tabs (Flows board, Gallery of every sticky, Data model, Glossary, Overview) with a sticky-lane board, detail panel, search, group-by pivots, and vsco", URL="vscode://file//event-storming-recovery/src/application/commands/generate-views.ts:57"];
    "build-example__ext-browser" [label="Web browser", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="The browser running the React explorer SPA. It fetched the whole model once from GET /api/model at boot and holds it in memory; clicking the 'Data model' tab flips the SPA into the DataModel view, which renders the physical layer as a pannable containment graph. The rendering never re-hits the serve", URL="vscode://file//event-storming-recovery/src/web/components/Tabs.jsx:6"];
    "build-example__ext-ci" [label="GitHub Actions CI", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="The repository's CI workflow. Its second job step runs `npm run demo` as a smoke build on every push to main and every pull request, exercising the whole offline pipeline (merge -> generate) end to end. Outside the tool's deploy boundary; here it is a second, automated trigger of the same compositio", URL="vscode://file//event-storming-recovery/.github/workflows/ci.yml:19"];
    "build-example__actor-operator" -> "build-example__cmd-build-example" [label="issues"];
    "build-example__ext-ci" -> "build-example__cmd-build-example" [label="issues"];
    "build-example__cmd-build-example" -> "build-example__cmd-merge-traces" [label="calls"];
    "build-example__cmd-build-example" -> "build-example__cmd-generate-views" [label="calls"];
    "build-example__rm-explorer-html" -> "build-example__ext-browser" [label="read by"];
  }
  subgraph "cluster_copy-for-claude" {
    label="Operator copies grounded markdown for a Claude session"; fontsize=13; color="#4a4a56"; style="rounded"; fontcolor="#e4e4e7";
    "copy-for-claude__actor-operator" [label="Operator", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded", tooltip="The local developer who runs the recovery CLIs. Here they launch the interactive explorer with `npx event-storming-recovery view` (the `es-view` bin), optionally passing --model / --traces / --port / --no-open, to boot one local server that serves the SPA + JSON API + MCP over a shared in-memory ses"];
    "copy-for-claude__cmd-copy-for-claude" [label="CopyGroundedMarkdown", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Copy the grounded Markdown for one item (node / flow / hotspot) or the whole context bundle to the clipboard so it can be pasted into a Claude chat. A read/export action: it mutates no model state, it fetches a freshly-rendered Markdown projection and writes it to the external clipboard.", URL="vscode://file//event-storming-recovery/src/web/components/Detail.jsx:167"];
    "copy-for-claude__rm-grounded-markdown" [label="Grounded Markdown export", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The ready-to-paste, source-anchored Markdown rendering of a node, flow, hotspot, or bundle: label, description, tags, fields, invariants/related, flows, and for every anchor the ACTUAL source code re-read from disk, plus any human comments. This is the same projection the MCP side hands to a connect", URL="vscode://file//event-storming-recovery/src/application/read-models/context.ts:227"];
    "copy-for-claude__ext-clipboard" [label="OS clipboard", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="The browser/OS clipboard, written via the async Clipboard API (navigator.clipboard.writeText). The external sink of this flow: the grounded markdown lands here so the operator can paste it wherever they want a Claude session.", URL="vscode://file//event-storming-recovery/src/web/components/Detail.jsx:167"];
    "copy-for-claude__ext-claude-mcp" [label="Connected Claude (MCP client)", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="A connected Claude session acting as an MCP client over the /mcp boundary in the same process. It is the downstream consumer this whole flow exists to serve: after the operator clicks, Claude pulls the selection via the get_current_selection MCP tool to answer about 'the node the user is looking at'", URL="vscode://file//event-storming-recovery/src/adapters/mcp/mcp-server.ts:117"];
    "copy-for-claude__agg-model" [label="The Model", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The canonical Event Storming model (flows.json): deduped nodes plus flows, hotspots, terms, and derived meta. Loaded by the launch flow via resolveModel (precedence --model > --traces merge > auto-discovered > bundled example) and held in memory for the session to serve. Owned/defined by the merge a", URL="vscode://file//event-storming-recovery/src/domain/model/merge.ts:109"];
    "copy-for-claude__agg-context-bundle" [label="Context Bundle", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The insertion-ordered set of typed refs { type: 'node' | 'flow' | 'hotspot', id } the human has gathered in the explorer (right-click, 'Add to context bundle'). Purely in-memory session state; the read half consumed by the selected-nodes MCP resource. Shares one createState() closure with the curren", URL="vscode://file//event-storming-recovery/src/domain/session/context-bundle.ts:18"];
    "copy-for-claude__agg-comment-store" [label="Comment Store", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The human-comments boundary: an in-memory Map of 'type:id' -> [{ id, text, at }] created per server run, mirrored to a comments.json sidecar next to the model. It deliberately lives OUTSIDE flows.json (which the recovery/merge pipeline regenerates and would wipe) and keys every note by the item's st", URL="vscode://file//event-storming-recovery/src/domain/comment-store/comment-store.ts:29"];
    "copy-for-claude__inv-copy-target-exists" [label="Copy target must resolve to a known model item", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="ERROR-level guard: the copied item id must resolve to a real node/flow/hotspot in the model, else GET /api/item returns 404 and no markdown is produced. This is referential integrity at the read boundary -- a stale or wrong id cannot fabricate an export. (Note the client swallows the 404 into an emp", URL="vscode://file//event-storming-recovery/src/application/read-models/items.ts:5"];
    "copy-for-claude__actor-operator" -> "copy-for-claude__cmd-copy-for-claude" [label="issues"];
    "copy-for-claude__cmd-copy-for-claude" -> "copy-for-claude__rm-grounded-markdown" [label="reads"];
    "copy-for-claude__rm-grounded-markdown" -> "copy-for-claude__agg-model" [label="projects from"];
    "copy-for-claude__rm-grounded-markdown" -> "copy-for-claude__agg-context-bundle" [label="projects from"];
    "copy-for-claude__rm-grounded-markdown" -> "copy-for-claude__agg-comment-store" [label="reads"];
    "copy-for-claude__agg-model" -> "copy-for-claude__inv-copy-target-exists" [label="enforces"];
    "copy-for-claude__cmd-copy-for-claude" -> "copy-for-claude__ext-clipboard" [label="writes"];
    "copy-for-claude__ext-clipboard" -> "copy-for-claude__ext-claude-mcp" [label="read by"];
  }
  subgraph "cluster_generate-views" {
    label="Operator generates the DOT + explorer views from the validated model"; fontsize=13; color="#4a4a56"; style="rounded"; fontcolor="#e4e4e7";
    "generate-views__actor-operator" [label="Operator", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded", tooltip="The local developer who runs the recovery CLIs. Here they launch the interactive explorer with `npx event-storming-recovery view` (the `es-view` bin), optionally passing --model / --traces / --port / --no-open, to boot one local server that serves the SPA + JSON API + MCP over a shared in-memory ses"];
    "generate-views__cmd-generate-views" [label="GenerateViews", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Render the canonical flows.json into the two shipped views: a Graphviz flows.dot digraph (one cluster per flow, event-storming palette) and a single self-contained explorer.html with the whole model inlined. A deterministic, stateless projection: it reads the model and writes two files, mutating not", URL="vscode://file//event-storming-recovery/src/adapters/cli/es-generate.ts:25"];
    "generate-views__agg-model" [label="The Model", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The canonical Event Storming model (flows.json): deduped nodes plus flows, hotspots, terms, and derived meta. Loaded by the launch flow via resolveModel (precedence --model > --traces merge > auto-discovered > bundled example) and held in memory for the session to serve. Owned/defined by the merge a", URL="vscode://file//event-storming-recovery/src/domain/model/merge.ts:109"];
    "generate-views__rm-flows-dot" [label="Graphviz flows.dot", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The Graphviz digraph the operator renders offline (e.g. `dot -Tsvg model/flows.dot`) or opens in a Graphviz viewer to read the whole board at a glance: one clustered subgraph per flow, event-storming-colored stickies, labeled edges, dead flows dashed and greyed. Physical storage nodes (datastore/fie", URL="vscode://file//event-storming-recovery/src/application/commands/generate-views.ts:20"];
    "generate-views__rm-explorer-html" [label="Interactive explorer.html", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The self-contained, no-server interactive explorer the operator opens in a browser: the whole model is inlined as a JS constant and rendered into five tabs (Flows board, Gallery of every sticky, Data model, Glossary, Overview) with a sticky-lane board, detail panel, search, group-by pivots, and vsco", URL="vscode://file//event-storming-recovery/src/application/commands/generate-views.ts:57"];
    "generate-views__ext-browser" [label="Web browser", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="The browser running the React explorer SPA. It fetched the whole model once from GET /api/model at boot and holds it in memory; clicking the 'Data model' tab flips the SPA into the DataModel view, which renders the physical layer as a pannable containment graph. The rendering never re-hits the serve", URL="vscode://file//event-storming-recovery/src/web/components/Tabs.jsx:6"];
    "generate-views__ext-graphviz" [label="Graphviz (dot)", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="The external Graphviz `dot` renderer the operator runs over flows.dot (e.g. `dot -Tsvg`) to produce a static image of the whole board. Not bundled; the generator only emits the .dot source.", URL="vscode://file//event-storming-recovery/src/application/commands/generate-views.ts:27"];
    "generate-views__ext-vscode" [label="VS Code", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="The local editor targeted by the vscode://file/<repoRoot>/<path>:<line> deep links baked into both flows.dot node URLs and the explorer.html anchors. Clicking a recovered concept opens the exact source line in the analyzed checkout. Outside the tool's boundary.", URL="vscode://file//event-storming-recovery/src/web/model.js:43"];
