  subgraph "cluster_merge-traces" {
    label="Operator merges per-flow traces into the validated model"; fontsize=13; color="#4a4a56"; style="rounded"; fontcolor="#e4e4e7";
    "merge-traces__actor-operator" [label="Operator", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded", tooltip="The local developer who runs the recovery CLIs. Here they launch the interactive explorer with `npx event-storming-recovery view` (the `es-view` bin), optionally passing --model / --traces / --port / --no-open, to boot one local server that serves the SPA + JSON API + MCP over a shared in-memory ses"];
    "merge-traces__rm-trace" [label="Per-flow trace JSON", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="A single per-flow trace document authored by a deep-trace agent: { nodes, flows, hotspots, terms } for one flow. Every such file in the traces directory is the raw material the merge consumes; a parse failure is collected and the file skipped rather than aborting the run.", URL="vscode://file//event-storming-recovery/src/adapters/fs/model-repository.ts:51"];
    "merge-traces__cmd-merge-traces" [label="MergeTraces", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Fold every per-flow trace document into one canonical, validated model. Invoked in-process by ResolveModel's --traces tier (merge-on-the-fly) instead of via the es-merge CLI; resolveModel throws if the merge reports any validation error, so the session never serves an invalid merged model.", URL="vscode://file//event-storming-recovery/src/application/commands/merge-traces.ts:16"];
    "merge-traces__agg-model" [label="The Model", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The canonical Event Storming model (flows.json): deduped nodes plus flows, hotspots, terms, and derived meta. Loaded by the launch flow via resolveModel (precedence --model > --traces merge > auto-discovered > bundled example) and held in memory for the session to serve. Owned/defined by the merge a", URL="vscode://file//event-storming-recovery/src/domain/model/merge.ts:109"];
    "merge-traces__evt-model-merged" [label="ModelMerged", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded", tooltip="The per-flow traces have been folded into one deduped model: shared nodes unioned by global id, flows/hotspots/terms accumulated, and derived meta (counts, shared-concept glossary, dead-flow index) computed. This fact holds even when the model is later found invalid.", URL="vscode://file//event-storming-recovery/src/domain/model/merge.ts:38"];
    "merge-traces__evt-model-validated" [label="ModelValidated", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded", tooltip="The merged model has been checked against every invariant and passed with zero errors, so it is safe to serve or persist. When errors exist this fact does NOT hold: the CLI reports them and exits nonzero, and the server throws and refuses to serve. It is a separately-observable outcome from ModelMer", URL="vscode://file//event-storming-recovery/src/domain/model/merge.ts:90"];
    "merge-traces__inv-referential-integrity" [label="Every id reference resolves and ids are unique", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="The model must be a closed graph: nodes are well-formed with a known type and a unique id, and every reference (flow steps, edge from/to, flow hotspots, term relatedNodes) points at a defined node. Dangling references or id collisions are ERRORS that fail the merge. (Orphan nodes and nonstandard edg", URL="vscode://file//event-storming-recovery/src/domain/model/invariants.ts:83"];
    "merge-traces__inv-es-grammar" [label="Aggregates never issue commands", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="The one hard Event Storming grammar rule enforced at merge time: an aggregate may only receive commands and emit events, never issue one. An edge whose from-node is an aggregate with verb 'issues' is an ERROR. Policies-issue-commands and command-lookup shapes are left to author discipline.", URL="vscode://file//event-storming-recovery/src/domain/model/invariants.ts:98"];
    "merge-traces__inv-terms-contract" [label="Terms are resolved-with-definition or flagged-with-a-question", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="Every ubiquitous-language term must be well-formed and honor the flag-or-resolve contract: a resolved term carries a definition; a partial/unresolved term carries the specific openQuestion a human should answer; and any relatedNodes must resolve to known nodes. Violations are ERRORS. A nonstandard c", URL="vscode://file//event-storming-recovery/src/domain/model/invariants.ts:107"];
    "merge-traces__inv-data-lineage" [label="Physical containment and field lineage are well-formed", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="The data-model layer must be internally consistent: a physical node's parent must resolve and form an acyclic containment chain, and each field must carry a non-empty name and derivation with any local-looking source ref resolving to a known node. Violations are ERRORS; a parent at the wrong contain", URL="vscode://file//event-storming-recovery/src/domain/model/invariants.ts:64"];
    "merge-traces__inv-anchor-coverage" [label="Behavioral nodes carry source anchors", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="A soft (WARNING-only) invariant: nodes of an anchor-required type (command, aggregate, event, policy, readModel, invariant) should carry at least one tactical.anchor, so the recovered concept always deep-links back to code. Unlike the referential and grammar rules this does NOT fail the merge; it on", URL="vscode://file//event-storming-recovery/src/domain/model/merge.ts:35"];
    "merge-traces__actor-operator" -> "merge-traces__cmd-merge-traces" [label="issues"];
    "merge-traces__cmd-merge-traces" -> "merge-traces__rm-trace" [label="reads"];
