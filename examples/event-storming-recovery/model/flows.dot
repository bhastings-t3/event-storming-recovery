    "generate-views__evt-views-generated" [label="ViewsGenerated", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded", tooltip="The read-model views (flows.dot + explorer.html) have been rendered from the current model and written into the output directory, ready for a human to open, share, or feed to Graphviz. The single domain fact promoted out of the render pipeline.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/tools/generate-views.js:91"];
