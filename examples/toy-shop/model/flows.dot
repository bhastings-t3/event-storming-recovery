digraph event_storming {
  bgcolor="#0a0a0d"; rankdir=LR; fontname="Segoe UI"; compound=true;
  node [shape=box, style="filled,rounded", fontname="Segoe UI", fontsize=10, margin="0.15,0.08"];
  edge [fontname="Segoe UI", fontsize=8, color="#8a8a94", fontcolor="#a1a1aa"];
  subgraph "cluster_express-checkout" {
    label="Customer checks out in one tap (retired)  [DEAD]"; fontsize=13; color="#3a3a44"; style="rounded"; fontcolor="#71717a";
    "express-checkout__actor-customer" [label="Customer", fillcolor="#D4A017", color="#6e5300", fontcolor="#241a00", style="filled,rounded,dashed", tooltip="A shopper who has added items to their cart and checks out."];
    "express-checkout__cmd-express-checkout" [label="ExpressCheckout", fillcolor="#5B9DF0", color="#1e4e8a", fontcolor="#08182f", style="filled,rounded,dashed", tooltip="One-tap checkout that skipped the cart review and stock check, charging a saved card immediately.", URL="vscode://file/./src/services/OrderService.ts:90"];
    "express-checkout__agg-order" [label="Order", fillcolor="#F3E27E", color="#8a7a1f", fontcolor="#2a2600", style="filled,rounded,dashed", tooltip="A customer order: header plus line items, with status and total. Emits an event when placed.", URL="vscode://file/./src/services/OrderService.ts:31"];
    "express-checkout__evt-order-placed" [label="OrderPlaced", fillcolor="#F5A524", color="#7a5205", fontcolor="#2b1a00", style="filled,rounded,dashed", tooltip="An order existed in status Placed — but possibly for out-of-stock items in this retired path.", URL="vscode://file/./src/services/OrderService.ts:61"];
    "express-checkout__actor-customer" -> "express-checkout__cmd-express-checkout" [label="issues"];
    "express-checkout__cmd-express-checkout" -> "express-checkout__agg-order" [label="handled by"];
    "express-checkout__agg-order" -> "express-checkout__evt-order-placed" [label="emits"];
  }
  subgraph "cluster_place-order" {
    label="Customer places an order"; fontsize=13; color="#4a4a56"; style="rounded"; fontcolor="#e4e4e7";
    "place-order__actor-customer" [label="Customer", fillcolor="#D4A017", color="#6e5300", fontcolor="#241a00", style="filled,rounded", tooltip="A shopper who has added items to their cart and checks out."];
    "place-order__rm-cart" [label="Cart summary", fillcolor="#5FD08A", color="#237a47", fontcolor="#062a17", style="filled,rounded", tooltip="The line items, quantities, and running total the customer reviews before checkout.", URL="vscode://file/./src/web/CartPage.tsx:42"];
    "place-order__cmd-place-order" [label="PlaceOrder", fillcolor="#5B9DF0", color="#1e4e8a", fontcolor="#08182f", style="filled,rounded", tooltip="Customer submits the cart as an order.", URL="vscode://file/./src/web/CartPage.tsx:88"];
    "place-order__agg-order" [label="Order", fillcolor="#F3E27E", color="#8a7a1f", fontcolor="#2a2600", style="filled,rounded", tooltip="A customer order: header plus line items, with status and total. Emits an event when placed.", URL="vscode://file/./src/services/OrderService.ts:31"];
    "place-order__evt-order-placed" [label="OrderPlaced", fillcolor="#F5A524", color="#7a5205", fontcolor="#2b1a00", style="filled,rounded", tooltip="An order existed in status Placed — but possibly for out-of-stock items in this retired path.", URL="vscode://file/./src/services/OrderService.ts:61"];
    "place-order__ext-payments" [label="Payment gateway", fillcolor="#F080AE", color="#9c355f", fontcolor="#360a20", style="filled,rounded", tooltip="Third-party payment processor. Authorizes and captures card charges over HTTPS.", URL="vscode://file/./src/services/PaymentGateway.ts:12"];
    "place-order__pol-reserve-stock" [label="Whenever an order is placed, reserve its stock", fillcolor="#BB8FEA", color="#603a99", fontcolor="#22103a", style="filled,rounded", tooltip="Placing an order immediately decrements on-hand stock for each line so the same unit can't be sold twice.", URL="vscode://file/./src/services/OrderService.ts:63"];
    "place-order__cmd-reserve-stock" [label="ReserveStock", fillcolor="#5B9DF0", color="#1e4e8a", fontcolor="#08182f", style="filled,rounded", tooltip="Decrement on-hand stock for each ordered line.", URL="vscode://file/./src/services/InventoryService.ts:20"];
    "place-order__agg-inventory" [label="Inventory", fillcolor="#F3E27E", color="#8a7a1f", fontcolor="#2a2600", style="filled,rounded", tooltip="On-hand stock per SKU. Decremented when an order reserves stock.", URL="vscode://file/./src/services/InventoryService.ts:20"];
    "place-order__evt-stock-reserved" [label="StockReserved", fillcolor="#F5A524", color="#7a5205", fontcolor="#2b1a00", style="filled,rounded", tooltip="On-hand stock has been decremented for the order's lines.", URL="vscode://file/./src/services/InventoryService.ts:26"];
    "place-order__inv-stock-available" [label="Every line must have stock available", fillcolor="#2c2c34", color="#4a4a56", fontcolor="#c9c9d4", style="filled,rounded", tooltip="An order is rejected if any line item's requested quantity exceeds on-hand stock.", URL="vscode://file/./src/services/OrderService.ts:40"];
    "place-order__inv-payment-authorized" [label="Payment must authorize before the order is created", fillcolor="#2c2c34", color="#4a4a56", fontcolor="#c9c9d4", style="filled,rounded", tooltip="The order is only written after the payment gateway authorizes the charge.", URL="vscode://file/./src/services/OrderService.ts:52"];
    "place-order__rm-cart" -> "place-order__actor-customer" [label="read by"];
    "place-order__actor-customer" -> "place-order__cmd-place-order" [label="issues"];
    "place-order__cmd-place-order" -> "place-order__agg-order" [label="handled by"];
    "place-order__agg-order" -> "place-order__inv-stock-available" [label="enforces"];
    "place-order__agg-order" -> "place-order__inv-payment-authorized" [label="enforces"];
    "place-order__cmd-place-order" -> "place-order__ext-payments" [label="calls"];
    "place-order__agg-order" -> "place-order__evt-order-placed" [label="emits"];
    "place-order__evt-order-placed" -> "place-order__pol-reserve-stock" [label="triggers"];
    "place-order__pol-reserve-stock" -> "place-order__cmd-reserve-stock" [label="issues"];
    "place-order__cmd-reserve-stock" -> "place-order__agg-inventory" [label="handled by"];
    "place-order__agg-inventory" -> "place-order__evt-stock-reserved" [label="emits"];
  }
}