    "generate-views__ext-editor" [label="Local editor (VS Code)", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="The OS/editor outside the process boundary that handles vscode://file/... deep links. The sibling grounding path: instead of the inline excerpt, the viewer clicks the anchor's <a> href, and the OS hands the vscode:// URL to the editor, which opens the real file at the given line straight from the fi", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/web/model.js:43"];
