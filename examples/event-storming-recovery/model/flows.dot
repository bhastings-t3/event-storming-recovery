    "generate-views__agg-model" [label="The Model", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The canonical Event Storming model (flows.json): the deduped node set plus flows, hotspots, terms, and derived meta. Built by the merge, then read by the es-view server and generator. In this flow it is read-only -- the source of truth the selection is validated against and grounded from.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/resolve-model.mjs:65"];
    "generate-views__rm-flows-dot" [label="Graphviz flows.dot", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The Graphviz digraph (flows.dot): one cluster per flow with event-storming-colored stickies and labeled edges, rendered offline (e.g. `dot -Tsvg`) or in a Graphviz viewer to read the whole board at a glance. Physical storage nodes and any edge touching them are deliberately excluded.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/tools/generate-views.js:64"];
