  subgraph "cluster_explore-and-select" {
    label="Human selects a node in the explorer; Claude reads it live"; fontsize=13; color="#4a4a56"; style="rounded"; fontcolor="#e4e4e7";
    "explore-and-select__actor-viewer" [label="Viewer", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded", tooltip="The human viewing the Event Storming explorer SPA. Here they curate a bundle: right-clicking or clicking 'Add to context' on nodes, whole flows, and hotspots to gather the set they want to hand to Claude, then optionally copying it or leaving it for a connected Claude session to @-mention."];
    "explore-and-select__cmd-select-node" [label="SelectNode", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Mark a domain node as the one the human is currently looking at, and mirror that choice to the shared server state so a connected Claude session can read it. Fired whenever the human opens any node's detail from anywhere in the SPA.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/web/store.jsx:40"];
    "explore-and-select__agg-selection" [label="Selection / Context bundle", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The live 'what am I looking at / what have I gathered' state for one es-view run, held purely in memory and shared same-process between the SPA API and the MCP bridge. This flow uses its bundle facet: an insertion-ordered set of typed refs { type: node|flow|hotspot, id }; the selection tracer uses t", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/state.mjs:11"];
    "explore-and-select__evt-node-selected" [label="NodeSelected", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded", tooltip="The human has selected a (model-valid) node; the shared in-memory selection now points at it, stamped with the time of the click. This is the push half of the bridge: recorded the instant the human clicks, with no subscription opened.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/server.mjs:132"];
    "explore-and-select__rm-current-selection" [label="Current selection (grounded)", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The grounded projection of the selected node that a connected Claude session (or the SPA detail panel) reads: the node's label, type, description, the invariants it enforces, the flows it appears in, and the REAL source behind each anchor. Pull-based and always fresh -- computed on each request from", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/mcp.mjs:30"];
    "explore-and-select__actor-claude" [label="Connected Claude session", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded", tooltip="A Claude session connected to the es-view MCP endpoint (same process as the SPA). It reads the curated bundle by @-mentioning the event-storming://selected-nodes resource, receiving the whole gathered set as grounded markdown so a refactor request is anchored to real files, not just labels."];
    "explore-and-select__inv-selection-in-model" [label="The selected node must exist in the model", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="The selection may only ever point at a node that exists in the merged model. If the POST supplies a nodeId that the model does not contain, the request is rejected with 404 and the selection is left unchanged. (An empty/null body is allowed and clears the selection to null.)", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/server.mjs:131"];
    "explore-and-select__agg-model" [label="The Model", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The canonical Event Storming model (flows.json): the deduped node set plus flows, hotspots, terms, and derived meta. Built by the merge, then read by the es-view server and generator. In this flow it is read-only -- the source of truth the selection is validated against and grounded from.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/resolve-model.mjs:65"];
