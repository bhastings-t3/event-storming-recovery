digraph event_storming {
  bgcolor="#0a0a0d"; rankdir=LR; fontname="Segoe UI"; compound=true;
  node [shape=box, style="filled,rounded", fontname="Segoe UI", fontsize=10, margin="0.15,0.08"];
  edge [fontname="Segoe UI", fontsize=8, color="#8a8a94", fontcolor="#a1a1aa"];
  subgraph "cluster_express-checkout" {
    label="Customer checks out in one tap (retired)  [DEAD]"; fontsize=13; color="#3a3a44"; style="rounded"; fontcolor="#71717a";
    "express-checkout__actor-customer" [label="Customer", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded,dashed", tooltip="A shopper who has added items to their cart and checks out."];
    "express-checkout__cmd-express-checkout" [label="ExpressCheckout", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded,dashed", tooltip="One-tap checkout that skipped the cart review and stock check, charging a saved card immediately.", URL="vscode://file/./src/services/OrderService.ts:90"];
    "express-checkout__agg-order" [label="Order", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded,dashed", tooltip="A customer order: header plus line items, with status and total. Emits an event when placed.", URL="vscode://file/./src/services/OrderService.ts:31"];
    "express-checkout__evt-order-placed" [label="OrderPlaced", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded,dashed", tooltip="An order existed in status Placed — but possibly for out-of-stock items in this retired path.", URL="vscode://file/./src/services/OrderService.ts:61"];
    "express-checkout__actor-customer" -> "express-checkout__cmd-express-checkout" [label="issues"];
    "express-checkout__cmd-express-checkout" -> "express-checkout__agg-order" [label="handled by"];
    "express-checkout__agg-order" -> "express-checkout__evt-order-placed" [label="emits"];
  }
  subgraph "cluster_place-order" {
    label="Customer places an order"; fontsize=13; color="#4a4a56"; style="rounded"; fontcolor="#e4e4e7";
    "place-order__actor-customer" [label="Customer", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded", tooltip="A shopper who has added items to their cart and checks out."];
    "place-order__rm-cart" [label="Cart summary", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The line items, quantities, and running total the customer reviews before checkout.", URL="vscode://file/./src/web/CartPage.tsx:42"];
    "place-order__cmd-place-order" [label="PlaceOrder", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Customer submits the cart as an order.", URL="vscode://file/./src/web/CartPage.tsx:88"];
    "place-order__agg-order" [label="Order", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="A customer order: header plus line items, with status and total. Emits an event when placed.", URL="vscode://file/./src/services/OrderService.ts:31"];
    "place-order__evt-order-placed" [label="OrderPlaced", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded", tooltip="An order existed in status Placed — but possibly for out-of-stock items in this retired path.", URL="vscode://file/./src/services/OrderService.ts:61"];
    "place-order__ext-payments" [label="Payment gateway", fillcolor="#E68DAF", color="#b05378", fontcolor="#59213b", style="filled,rounded", tooltip="Third-party payment processor. Authorizes and captures card charges over HTTPS.", URL="vscode://file/./src/services/PaymentGateway.ts:12"];
    "place-order__pol-reserve-stock" [label="Whenever an order is placed, reserve its stock", fillcolor="#BF9BE0", color="#8058b0", fontcolor="#3a2160", style="filled,rounded", tooltip="Placing an order immediately decrements on-hand stock for each line so the same unit can't be sold twice.", URL="vscode://file/./src/services/OrderService.ts:63"];
    "place-order__cmd-reserve-stock" [label="ReserveStock", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Decrement on-hand stock for each ordered line.", URL="vscode://file/./src/services/InventoryService.ts:20"];
    "place-order__agg-inventory" [label="Inventory", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="On-hand stock per SKU. Decremented when an order reserves stock.", URL="vscode://file/./src/services/InventoryService.ts:20"];
    "place-order__evt-stock-reserved" [label="StockReserved", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded", tooltip="On-hand stock has been decremented for the order's lines.", URL="vscode://file/./src/services/InventoryService.ts:26"];
    "place-order__inv-stock-available" [label="Every line must have stock available", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="An order is rejected if any line item's requested quantity exceeds on-hand stock.", URL="vscode://file/./src/services/OrderService.ts:40"];
    "place-order__inv-payment-authorized" [label="Payment must authorize before the order is created", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="The order is only written after the payment gateway authorizes the charge.", URL="vscode://file/./src/services/OrderService.ts:52"];
    "place-order__rm-cart" -> "place-order__actor-customer" [label="read by"];
    "place-order__actor-customer" -> "place-order__cmd-place-order" [label="issues"];
    "place-order__cmd-place-order" -> "place-order__agg-order" [label="handled by"];
    "place-order__agg-order" -> "place-order__inv-stock-available" [label="enforces"];
    "place-order__agg-order" -> "place-order__inv-payment-authorized" [label="enforces"];
    "place-order__cmd-place-order" -> "place-order__ext-payments" [label="calls"];
    "place-order__agg-order" -> "place-order__evt-order-placed" [label="emits"];
    "place-order__evt-order-placed" -> "place-order__pol-reserve-stock" [label="triggers"];
    "place-order__pol-reserve-stock" -> "place-order__cmd-reserve-stock" [label="issues"];
    "place-order__cmd-reserve-stock" -> "place-order__agg-inventory" [label="handled by"];
    "place-order__agg-inventory" -> "place-order__evt-stock-reserved" [label="emits"];
  }
}