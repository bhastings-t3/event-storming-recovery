  subgraph "cluster_curate-context-bundle" {
    label="Viewer curates a context bundle for a connected Claude session"; fontsize=13; color="#4a4a56"; style="rounded"; fontcolor="#e4e4e7";
    "curate-context-bundle__actor-viewer" [label="Viewer", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded", tooltip="The human viewing the Event Storming explorer SPA. Here they curate a bundle: right-clicking or clicking 'Add to context' on nodes, whole flows, and hotspots to gather the set they want to hand to Claude, then optionally copying it or leaving it for a connected Claude session to @-mention."];
    "curate-context-bundle__cmd-add-to-bundle" [label="AddToContextBundle", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Add one typed item (a node, a whole flow, or a hotspot) to the curated context bundle. The item must exist in the model for its declared type; adding an item already present is a no-op (the bundle is a set).", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/web/api.js:23"];
    "curate-context-bundle__agg-selection" [label="Selection / Context bundle", fillcolor="#E3D68A", color="#a89a4a", fontcolor="#4c4212", style="filled,rounded", tooltip="The live 'what am I looking at / what have I gathered' state for one es-view run, held purely in memory and shared same-process between the SPA API and the MCP bridge. This flow uses its bundle facet: an insertion-ordered set of typed refs { type: node|flow|hotspot, id }; the selection tracer uses t", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/state.mjs:11"];
    "curate-context-bundle__evt-bundle-item-added" [label="ContextItemAdded", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded", tooltip="A node, flow, or hotspot the human chose has entered the curated bundle. This is the domain-significant fact of the flow: the gathered set that Claude will read has grown by one grounded item.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/state.mjs:21"];
    "curate-context-bundle__rm-context-bundle" [label="Curated context bundle", fillcolor="#6FC993", color="#358a5a", fontcolor="#124a2c", style="filled,rounded", tooltip="The curated bundle projected to one grounded markdown document: each gathered node/flow/hotspot rendered with its description, invariants, flows, source anchors (real code), and for flows a colored Mermaid graph, joined by rules. This is what actor-claude reads. Exposed two ways: the MCP resource ev", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/context.mjs:158"];
    "curate-context-bundle__actor-claude" [label="Connected Claude session", fillcolor="#D2A63A", color="#98741a", fontcolor="#432f03", style="filled,rounded", tooltip="A Claude session connected to the es-view MCP endpoint (same process as the SPA). It reads the curated bundle by @-mentioning the event-storming://selected-nodes resource, receiving the whole gathered set as grounded markdown so a refactor request is anchored to real files, not just labels."];
    "curate-context-bundle__cmd-remove-from-bundle" [label="RemoveFromContextBundle", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Remove one typed item from the curated bundle. A correction the human makes while curating (the ✕ on a bundle row, or toggling off the same add control).", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/web/api.js:24"];
    "curate-context-bundle__cmd-clear-bundle" [label="ClearContextBundle", fillcolor="#6BA3E8", color="#2f68b0", fontcolor="#123252", style="filled,rounded", tooltip="Empty the whole curated bundle in one action (the drawer's 'Clear' button), discarding every gathered node/flow/hotspot.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/web/api.js:25"];
    "curate-context-bundle__inv-bundle-item-exists" [label="A bundle item references a real model item of its type, at most once", fillcolor="#26262e", color="#42424e", fontcolor="#b7b7c2", style="filled,rounded", tooltip="The curated bundle may only hold refs that resolve: each { type, id } must point at an existing node, flow, or hotspot for its declared type, and each type:id may appear at most once (the bundle is a set, insertion-ordered).", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/server.mjs:147"];
    "curate-context-bundle__evt-bundle-item-removed" [label="ContextItemRemoved", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded", tooltip="An item the human previously gathered has been taken out of the curated bundle.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/state.mjs:22"];
    "curate-context-bundle__evt-bundle-cleared" [label="ContextBundleCleared", fillcolor="#E9A23B", color="#a56a14", fontcolor="#4a2c02", style="filled,rounded", tooltip="The human emptied the whole curated bundle at once; nothing remains for Claude to read until they gather again.", URL="vscode://file/C:\Users\bhastings\Source\repos\event-storming-recovery\.claude\worktrees\feat+data-model-recovery/src/server/state.mjs:23"];
